# Root Gitignore for Kdrama Watchlist Monorepo

# Environment files
.env
.env.local
.env.*.local
*.env

# Backend (Laravel)
backend/vendor/
backend/node_modules/
backend/storage/*.key
backend/storage/logs/*
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/bootstrap/cache/*
backend/.phpunit.result.cache
backend/Homestead.json
backend/Homestead.yaml
backend/.env

# Frontend (React + Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Mobile (React Native + Expo)
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
mobile/*.log

# Logs & OS metadata
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
.vscode/
.idea/
